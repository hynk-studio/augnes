    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test:operator-pure-contracts": "node --import tsx scripts/test-vnext-operator-pure-contracts-v0-1.ts",
    "test:operator-browser-fixture": "node --import tsx scripts/test-vnext-operator-browser-fixture-v0-1.ts",
    "test:project-experience-browser-fixture": "node --import tsx scripts/test-project-experience-browser-fixture-v1.ts",
    "test:browser-verification-inventory": "node scripts/test-browser-verification-ownership-inventory.mjs",
    "test:project-work-initialization": "node --import tsx scripts/test-vnext-project-work-initialization.ts",
    "test:canonical-contract": "node scripts/test-local-canonical-verification-contract.mjs",
    "test:local-canonical-executor": "node scripts/test-local-canonical-executor.mjs",
    "test:local-canonical-receipt": "node scripts/test-local-canonical-receipt.mjs",
    "test:local-canonical-pr-evidence": "node scripts/test-local-canonical-pr-evidence.mjs",
    "test:local-canonical-pr-evidence-transport": "node scripts/test-local-canonical-pr-evidence-transport.mjs",
    "test:dependency-lock-compatibility": "node scripts/test-dependency-lock-compatibility.mjs",
    "test:c8-semantic-visual": "node --import tsx scripts/test-c8-semantic-visual-contract.mjs",
    "test:c8-visual-review": "AUGNES_C8_CAPTURE_REVIEW=1 node --import tsx scripts/browser-validate-vnext-native-host-result-v0-1.mjs",
    "verify:local:quick": "node scripts/run-local-canonical-verification.mjs quick",
    "verify:local:changed": "node scripts/run-local-canonical-verification.mjs changed",
    "verify:local:full": "node scripts/run-local-canonical-verification.mjs full",
    "verify:local:receipt": "node scripts/run-local-canonical-verification.mjs validate",
    "verify:local:evidence:prepare": "node scripts/local-canonical-pr-evidence.mjs prepare",
    "verify:local:evidence:publish": "node scripts/local-canonical-pr-evidence.mjs publish",
    "verify:local:evidence:verify": "node scripts/local-canonical-pr-evidence.mjs verify",
    "test": "node scripts/run-canonical-test-suite.mjs unit",
    "test:integration": "node scripts/run-canonical-test-suite.mjs integration",
    "test:integration:operator": "node scripts/run-canonical-test-suite.mjs integration-operator",
    "test:integration:supporting": "node scripts/run-canonical-test-suite.mjs integration-supporting",
    "test:authority": "node scripts/run-canonical-test-suite.mjs authority",
    "test:operability": "node scripts/run-canonical-test-suite.mjs operability",
    "test:operability:fast": "node scripts/run-canonical-test-suite.mjs operability-fast",
    "test:operability:recovery-validator": "node scripts/run-canonical-test-suite.mjs operability-recovery-validator",
    "test:operability:recovery-storage": "node scripts/run-canonical-test-suite.mjs operability-recovery-storage",
    "test:continuity-pins": "node --import tsx scripts/test-vnext-continuity-pins.ts",
    "test:operability:supervisor": "node scripts/run-canonical-test-suite.mjs operability-supervisor",
    "test:operability:runtime-reconciliation": "node scripts/run-canonical-test-suite.mjs operability-runtime-reconciliation",
    "test:operability:package": "node scripts/run-canonical-test-suite.mjs operability-package",
    "test:e2e": "node scripts/run-canonical-test-suite.mjs e2e",
    "test:e2e:core": "node scripts/run-canonical-test-suite.mjs e2e-core",
    "test:e2e:cux6b": "node scripts/run-canonical-test-suite.mjs e2e-cux6b",
    "test:e2e:project-experience": "node scripts/run-canonical-test-suite.mjs e2e-project-experience",
    "test:e2e:continuity": "node scripts/run-canonical-test-suite.mjs e2e-continuity"
  }
}
